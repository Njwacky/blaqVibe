# OpenRouter key — https://openrouter.ai/settings/keys
# (the same kind of key you added on Render as `openai_key`; keys start with sk-or-)
OPENROUTER_API_KEY=

# Only OPENROUTER_API_KEY / OPENAI_API_KEY / OPENAI_KEY / openai_key / AGENT_* /
# NOLO_* lines are read from a .env file (this one, then the BlaqVibes root one).
# SECRET_KEY, DATABASE_URL and the rest of the Django .env never enter the agent
# process, and shell commands Nolo runs get a scrubbed environment anyway.

# Optional overrides
# AGENT_MODEL=anthropic/claude-sonnet-4.5
# AGENT_MAX_STEPS=20
# AGENT_MAX_COST=1.0
# AGENT_APPROVAL=always            # always | dangerous-only | never
# NOLO_CWD=/path/to/blaqVibe
