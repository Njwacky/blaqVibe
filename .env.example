# BlaqVibes — Copy to .env and fill. Never commit .env
SECRET_KEY=change-me-in-prod
DEBUG=0
# LOCAL_DEV (which gates SECURE_SSL_REDIRECT, HSTS, cookie flags, X-Frame-Options,
# the dev SECRET_KEY and SEED_DEMO) is NO LONGER inferred from a virtualenv — a venv
# is also how production images get built, and the inference silently shipped
# unhardened sites. Set it to 1 on a laptop/staging box; leave it unset (or 0) on
# a public host. `python manage.py security_check` audits the result.
DJANGO_LOCAL_DEV=
# Operator account. When this is set, migrate/seed creates or repairs
# username `admin` with profile.role=superadmin (createsuperuser does not).
# The mailbox below is marked already-confirmed (no verify link).
# There is no built-in password — leave blank to skip.
# DJANGO_SUPERADMIN_USERNAME=admin
# DJANGO_SUPERADMIN_EMAIL=admin@blaqvibes.co.za
# DJANGO_SUPERADMIN_PASSWORD=
ALLOWED_HOSTS=blaqvibes.co.za,www.blaqvibes.co.za,blaqvibe.onrender.com
CSRF_TRUSTED_ORIGINS=https://blaqvibes.co.za,https://www.blaqvibes.co.za,https://blaqvibe.onrender.com
# Postgres in prod (Supabase is the default), SQLite only for local dev / CI.
# On Render, paste Supabase's connection string here (or as SUPABASE_URL — both
# names are read). Use SESSION mode (port 5432, e.g. …pooler.supabase.com:5432) —
# Django is a persistent backend, and the transaction pooler (port 6543) cannot
# hold Django's session state.
#   postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The direct string (db.<ref>.supabase.co:5432) is IPv6-only and usually won't
# connect from Render's IPv4 network — use the pooler.
DATABASE_URL=
# Mail — Brevo is the production path for activation & password-reset.
# Paste your Brevo API key (xkeysib-...) as BREVO_API_KEY and the backend
# auto-switches to Brevo. Blank = console backend (dev), which
# `manage.py security_check` ERRORs on in production.
#
# Get your key: https://app.brevo.com/settings/keys/api
# The sender email (DEFAULT_FROM_EMAIL) must be a verified sender in Brevo
# dashboard: https://app.brevo.com/settings/senders
#
# Still not arriving after setting these? On the deployed host run:
#     python manage.py diagnose_email --to you@example.com
# It stops at the first broken link (backend / key / sender / live send) and
# exits non-zero. Every rejection is also logged as BREVO_SEND_FAILED.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_NAME=BlaqVibes
BREVO_TIMEOUT=10
# Optional override: force a specific Django email backend.
# Leave blank to auto-select Brevo when BREVO_API_KEY is set, else console.
# WARNING: a non-empty value FORCES the backend and outranks BREVO_API_KEY —
# exporting console here means mail is logged and never delivered, no matter
# how correct the Brevo settings are. Delete the variable, don't blank it, on
# hosts where you want Brevo.
EMAIL_BACKEND=
# SMTP fallback (used only when EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@blaqvibes.co.za
# Required when using docker-compose. Generate a unique 32+ character value;
# compose now refuses to start with an empty/default database password.
POSTGRES_PASSWORD=
# Redis for Celery — the scan queue. Blank/unset means settings infer
# redis://localhost:6379/0, which `manage.py security_check` ERRORs on in
# production posture: a web process in a container or on a PaaS has no Redis on
# 127.0.0.1, so uploads queue into a broker nobody consumes and sit in
# "pending" forever. Use the service URL for compose (redis://redis:6379/0) or
# your provider's URL; localhost is right only on a single box that runs Redis.
REDIS_URL=redis://localhost:6379/0
# 1 = run scans inline (dev only). security_check ERRORs on it in production:
# a hostile ZIP scan takes up to its 120s hard limit inside the web request.
CELERY_EAGER=0
# ---------------------------------------------------------------------------
# Attention cases — duplicated builds + broken builds (gallery/attention.py).
# Every value here is quoted in user-visible copy generated from the same
# number, so the sentence "you have 7 days" and the clock that enforces it
# cannot disagree. Spec: docs/specs/BlaqVibes_Attention_Duplicates_Spec.md
# ---------------------------------------------------------------------------
# 0 disables detection, reminders and the banner. Existing cases are untouched.
ATTENTION_ENABLED=1
# Days the owner has to pick a keeper before BlaqVibes picks and explains why.
ATTENTION_DECISION_DAYS=7
# Minutes between nudges while a case is unanswered (banner + unread inbox bump).
ATTENTION_REMINDER_MINUTES=30
# After the owner OPENS a decision, hours of silence before the parked copy is
# erased. Silence after seeing it is the one silence treated as consent.
ATTENTION_FINAL_DELETE_HOURS=24
# Backstop for a decision nobody ever opened: longer, because nobody saw it.
ATTENTION_UNOPENED_BACKSTOP_DAYS=7
# Similarity score (0-100) at which two of one owner's builds become a case.
# Below 44 the detector falls back to comparing every pair — see the spec.
ATTENTION_DUPLICATE_THRESHOLD=70
# Hours a build may sit in "pending" with no scan verdict before that is
# reported as a malfunction of OUR pipeline rather than of the upload.
ATTENTION_STUCK_HOURS=48
# Owners per hourly detection sweep (most recently active first).
ATTENTION_DETECT_BATCH=400
SENTRY_DSN=
# Card checkout. Leave blank to use stars only — we will not fake a charge.
# Dashboard: https://dashboard.paystack.com/#/settings/developer
# Webhook: https://your-domain/paystack/webhook/
# Bank payouts to creators are not implemented. That needs this key PLUS
# Paystack Transfers enabled and each seller's bank details.
PAYSTACK_SECRET_KEY=
# Load the demo catalog on first visit / migrate (local). Off in production.
# NOTE: seed_demo creates the accounts documented in README.md (blaq / nolo.ai /
# thando with known passwords, verified wallets). The seeder therefore refuses
# to run unless DEBUG=1 or DJANGO_LOCAL_DEV=1 is set — and it will stay refused
# on a host that takes real uploads.
SEED_DEMO=
# Demo/staging escape hatch: publish the demo CATALOG without the credentials.
# Accounts are created with unusable passwords and 0 stars, and no staff rows
# are minted. Never set this on production; `manage.py security_check` ERRORs on it.
SEED_DEMO_FORCE=
# Cloudflare R2 (S3 compatible) — get from dash.cloudflare.com R2
# The media bucket MUST be private. A public-read policy leaks paid ZIPs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=blaqvibes-media
AWS_QUARANTINE_BUCKET=blaqvibes-quarantine
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
# ClamAV — runs in worker
CLAMAV_ENABLED=1
# Dependency existence check (slopsquatting defence). Fail-open: a registry
# outage never flags; 0 disables the registry calls entirely.
DEP_CHECK_ENABLED=1
# Max registry requests per hour, site-wide (token bucket; cached per name 24h).
DEP_CHECK_BUDGET=120
# AnyPost manual sharing. Use the exact API URL/path supplied by AnyPost.
ANYPOST_BASE_URL=
ANYPOST_ENDPOINT=
ANYPOST_API_KEY=
ANYPOST_TIMEOUT_SECONDS=15
# AI providers — Nolo chat/fix, kind classification, AI README, Nolo review,
# challenge drafts. Preference order: OpenRouter → OpenAI → Claude → Gemini →
# Groq → built-in helper. Leave everything blank = honest built-in helper, not
# a live model.
# 1. OpenRouter (first preference; one key, any model — https://openrouter.ai/settings/keys).
#    On Render the same key may be stored as `openai_key` / OPENAI_KEY / OPENAI_API_KEY:
#    an `sk-or-` key under any of those names is routed to OpenRouter automatically.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# 2. OpenAI (a real platform.openai.com key). OPENAI_BASE_URL only for compatible gateways.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# 3. Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# 4. Gemini, 5. Groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Web search — Brave Search API. NOT Brevo (the email service): the names are
# near-identical, but an app.brevo.com key (xkeysib-...) belongs to BREVO_API_KEY
# above and will be rejected by Brave with 401.
# Get your key: https://api-dashboard.search.brave.com
#   register → activate the (free) Search plan — a card on file may be
#   required even for the free tier → API Keys → copy the key.
# On Render, set it on the WEB service (the one blaqvibes.co.za is attached
# to, Settings → Domains) — a key set only on a worker service is invisible
# to the web process, and /ops/brave/ will report it as not set.
# Sent as the X-Subscription-Token header to https://api.search.brave.com.
# Verifying it without shell access (Render free tier): open /ops/brave/
# logged in as staff — it checks the key in the live process and makes one
# real test call, naming the broken layer.
BRAVE_API_KEY=
# Token economy for Nolo (gallery/prompt_economy.py + gallery/nolo_ai.py):
# the system prefix is stable first, the user payload last, and every input is
# budget-capped before it reaches a provider.
# Chat input budget in characters (default 1800). This is the cost dial for the
# "ask Nolo" prompt, not the output length.
NOLO_CHAT_USER_BUDGET_CHARS=1800
# Optional override for the stable system prefix Nolo sends first. The built-in
# default (gallery/nolo_ai.py) scopes Nolo to BlaqVibes: it identifies as
# BlaqVibes' Nolo, only refers to real pages/features, says when it cannot see
# something (accounts, balances, unpublished vibes) and never repeats secrets.
# Leave blank to use it; if you override, keep those rules.
NOLO_SYSTEM_PROMPT=
# Budget for that system prefix in characters (default 2600 — the grounded
# prompt is ~1.9k; prompt_economy's generic default of 900 would cut it).
NOLO_SYSTEM_BUDGET_CHARS=2600
# Nolo chat's only live data is public: the published-vibe count, the latest
# published vibes and the category list (gallery/nolo_context.py) — the same
# information the chat page shows to a logged-out visitor. Nothing pending,
# quarantined, removed or personal. With no API key at all, Nolo still answers
# "how many vibes are published?" live by counting the database herself.
# Code/README budget in characters (default 8000). Pasted code is cut on a
# line boundary instead of eating a 36k-char prompt per request.
NOLO_CODE_PROMPT_BUDGET_CHARS=8000
# Cap on generated output tokens (240 if unset; the example pins 180 because
# Nolo chat answers are meant to be short).
NOLO_OUTPUT_MAX_TOKENS=180
# Only send a provider prompt-cache hint when the stable system prefix reaches
# this many tokens. Smaller prefixes are still first, but a cache hint on a too
# small block can be rejected by the provider, so we do not guess.
NOLO_CACHE_MIN_TOKENS=1024
# Public site origin — must match the OAuth redirect host
SITE_URL=https://blaqvibes.co.za
# Social login (OAuth). A provider's button appears only when BOTH its id and
# its secret are set — half-filled means no button. See docs/specs/SOCIAL_AUTH.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Logging verbosity for console logs (DEBUG/INFO/WARNING/ERROR). INFO shows
# app activity; DEBUG is for a bad night, WARNING+ is quiet-mode.
LOG_LEVEL=INFO
# Only list reverse-proxy IPs that overwrite X-Forwarded-For. Leave blank when
# gunicorn is reachable directly; client-supplied forwarded headers are ignored.
SECURITY_TRUSTED_PROXY_IPS=
