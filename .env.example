# BlaqVibes — Copy to .env and fill. Never commit .env
SECRET_KEY=change-me-in-prod
DEBUG=0
ALLOWED_HOSTS=blaqvibes.co.za,www.blaqvibes.co.za
CSRF_TRUSTED_ORIGINS=https://blaqvibes.co.za,https://www.blaqvibes.co.za
# Postgres in prod, SQLite if unset
DATABASE_URL=
# Redis for Celery
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=0
SENTRY_DSN=
PAYSTACK_SECRET_KEY=
# Cloudflare R2 (S3 compatible) — get from dash.cloudflare.com R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=blaqvibes-public
AWS_QUARANTINE_BUCKET=blaqvibes-quarantine
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
# ClamAV — runs in worker
CLAMAV_ENABLED=1
GEMINI_API_KEY=
GROQ_API_KEY=
