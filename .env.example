# BlaqVibes — Copy to .env and fill. Never commit .env
SECRET_KEY=change-me-in-prod
DEBUG=0
ALLOWED_HOSTS=blaqvibes.co.za,www.blaqvibes.co.za
CSRF_TRUSTED_ORIGINS=https://blaqvibes.co.za,https://www.blaqvibes.co.za
# Postgres in prod, SQLite if unset
DATABASE_URL=
# Redis for Celery
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=0
SENTRY_DSN=
# Card checkout. Leave blank to use stars only — we will not fake a charge.
# Dashboard: https://dashboard.paystack.com/#/settings/developer
# Webhook: https://your-domain/paystack/webhook/
# Bank payouts to creators are not implemented. That needs this key PLUS
# Paystack Transfers enabled and each seller's bank details.
PAYSTACK_SECRET_KEY=
# Load the demo catalog on first visit / migrate (local). Off in production unless set.
SEED_DEMO=
# Email — leave commented in dev: mail prints to the runserver logs.
# Production has NO silent default: set a real backend + creds or signup /
# password-reset / queue-done mail fails loudly instead of vanishing.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=noreply@blaqvibes.co.za
# Cloudflare R2 (S3 compatible) — get from dash.cloudflare.com R2
# The media bucket MUST be private. A public-read policy leaks paid ZIPs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=blaqvibes-media
AWS_QUARANTINE_BUCKET=blaqvibes-quarantine
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
# ClamAV — runs in worker
CLAMAV_ENABLED=1
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional Nolo / AI README. Leave blank = built-in helper, not a live model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Public site origin — must match the OAuth redirect host
SITE_URL=https://blaqvibes.co.za
# Social login — leave blank to hide that button. See docs/specs/SOCIAL_AUTH.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
